---
import type { ContentImage, ContentAnimation } from './types'

interface Props {
  content: {
    badge: string
    heading: string
    body: string
    images: {
      main: ContentImage
    }
    animations?: ContentAnimation[]
  }
}

const { content } = Astro.props
---

<section id="amenities" class="py-24 bg-background-warm">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div>
        <p class="text-accent uppercase tracking-widest text-sm mb-4" data-animate="fadeInUp">
          {content.badge}
        </p>
        <h2 class="font-heading text-3xl md:text-4xl text-foreground mb-6" data-animate="fadeInUp">
          {content.heading}
        </h2>
        <p class="text-muted text-lg leading-relaxed" data-animate="fadeInUp">
          {content.body}
        </p>
      </div>
      <div data-animate="fadeInRight">
        <img
          src={content.images.main.src}
          alt={content.images.main.alt}
          class="w-full h-[500px] object-cover"
        />
      </div>
    </div>
  </div>
</section>
