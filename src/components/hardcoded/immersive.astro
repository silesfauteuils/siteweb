---
import type { ContentImage, ContentAnimation } from './types'

interface Props {
  content: {
    heading: string
    body: string
    mainImage: ContentImage
    gridImages: ContentImage[]
    animations?: ContentAnimation[]
  }
}

const { content } = Astro.props
---

<section class="bg-background py-24">
  <div class="max-w-7xl mx-auto px-6">
    <div class="max-w-3xl mb-16 opacity-0" data-animate="fadeInUp">
      <h2 class="font-heading text-4xl md:text-5xl text-foreground leading-tight">
        {content.heading}
      </h2>
      <p class="font-body text-muted text-lg mt-6 leading-relaxed">
        {content.body}
      </p>
    </div>

    <div class="mb-12 rounded-2xl overflow-hidden opacity-0" data-animate="fadeInUp">
      <img
        src={content.mainImage.src}
        alt={content.mainImage.alt}
        class="w-full h-[500px] object-cover"
      />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {content.gridImages.map((image, index) => (
        <div
          class="rounded-2xl overflow-hidden aspect-video opacity-0"
          data-animate="fadeInUp"
          data-delay={index * 0.1}>
          <img
            src={image.src}
            alt={image.alt}
            class="w-full h-full object-cover"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap"

  document.querySelectorAll(".immersive-grid img").forEach((img) => {
    const parent = img.closest(".rounded-2xl") || img.parentElement
    if (!parent) return

    parent.addEventListener("mouseenter", () => {
      gsap.to(img, { scale: 1.05, duration: 0.6, ease: "power2.out" })
    })

    parent.addEventListener("mouseleave", () => {
      gsap.to(img, { scale: 1, duration: 0.6, ease: "power2.out" })
    })
  })
</script>
