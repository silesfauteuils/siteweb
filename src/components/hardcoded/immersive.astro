---
import type { ContentAnimation, ContentImage } from './types'

interface Props {
  content: {
    heading: string
    body: string
    mainImage: ContentImage
    gridImages: ContentImage[]
    animations?: ContentAnimation[]
  }
}

const { content } = Astro.props
---

<section class="bg-background py-24">
  <div class="max-w-7xl mx-auto px-6">
    <div class="max-w-3xl mb-16" data-animate="fadeInUp">
      <h2 class="font-heading text-4xl md:text-5xl text-foreground leading-tight">
        {content.heading}
      </h2>
      <p class="font-body text-muted text-lg mt-6 leading-relaxed">
        {content.body}
      </p>
    </div>

    <div class="mb-12 rounded-2xl overflow-hidden" data-animate="fadeInUp">
      <img
        src={content.mainImage.src}
        alt={content.mainImage.alt}
        class="w-full h-[500px] object-cover"
      />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {content.gridImages.map((image, index) => (
        <div
          class="rounded-2xl overflow-hidden aspect-video"
          data-animate="fadeInUp"
          style={`transition-delay: ${index * 0.1}s`}
        >
          <img
            src={image.src}
            alt={image.alt}
            class="w-full h-full object-cover"
          />
        </div>
      ))}
    </div>
  </div>
</section>
