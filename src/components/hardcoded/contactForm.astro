---
import type { ContentAnimation } from "./types"

interface Props {
  content: {
    description: string
    animations?: ContentAnimation[]
  }
}

const { content } = Astro.props
---

<section class="py-16 md:py-24 bg-background-warm">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div class="space-y-6">
        <p
          class="text-muted text-lg leading-relaxed whitespace-pre-line opacity-0"
          data-animate="fadeInUp"
          data-delay="0">
          <Fragment set:html={content.description} />
        </p>
      </div>

      <div class="opacity-0" data-animate="fadeInUp" data-delay="0.1">
        <form
          id="contact-form"
          class="space-y-6 bg-white p-8 rounded-xl shadow-sm">
          <div id="form-status" class="hidden"></div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label
                for="nom"
                class="block text-sm font-medium text-foreground mb-2"
                >Nom *</label
              >
              <input
                type="text"
                id="nom"
                name="nom"
                required
                class="w-full px-4 py-3 border border-foreground/10 rounded-lg bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-accent/50"
              />
            </div>
            <div>
              <label
                for="prenom"
                class="block text-sm font-medium text-foreground mb-2"
                >Prénom *</label
              >
              <input
                type="text"
                id="prenom"
                name="prenom"
                required
                class="w-full px-4 py-3 border border-foreground/10 rounded-lg bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-accent/50"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label
                for="telephone"
                class="block text-sm font-medium text-foreground mb-2"
                >Téléphone *</label
              >
              <input
                type="tel"
                id="telephone"
                name="telephone"
                required
                class="w-full px-4 py-3 border border-foreground/10 rounded-lg bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-accent/50"
              />
            </div>
            <div>
              <label
                for="email"
                class="block text-sm font-medium text-foreground mb-2"
                >Email *</label
              >
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-foreground/10 rounded-lg bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-accent/50"
              />
            </div>
          </div>

          <div>
            <label
              for="ville"
              class="block text-sm font-medium text-foreground mb-2"
              >Ville de résidence</label
            >
            <input
              type="text"
              id="ville"
              name="ville"
              class="w-full px-4 py-3 border border-foreground/10 rounded-lg bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-accent/50"
            />
          </div>

          <div>
            <label
              for="message"
              class="block text-sm font-medium text-foreground mb-2"
              >Message *</label
            >
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              class="w-full px-4 py-3 border border-foreground/10 rounded-lg bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-accent/50 resize-y"
            ></textarea>
          </div>

          <div>
            <label
              for="piece-jointe"
              class="block text-sm font-medium text-foreground mb-2"
              >Pièces jointes</label
            >
            <input
              type="file"
              id="piece-jointe"
              name="piece-jointe"
              multiple
              accept="image/*,.pdf"
              class="w-full text-sm text-foreground file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:font-semibold file:bg-accent file:text-white hover:file:bg-accent/90"
            />
            <p class="text-xs text-muted mt-2">
              Formats acceptés : images et PDF (max 10 Mo par fichier)
            </p>
          </div>

          <div>
            <button
              type="submit"
              data-submit-button
              class="w-full px-8 py-4 bg-accent text-white uppercase tracking-widest text-sm rounded-lg hover:bg-accent/90 transition-colors">
              Envoyer ma demande
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script type="module">
  const form = document.getElementById("contact-form")
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault()

      const button = form.querySelector("[data-submit-button]")
      const status = document.getElementById("form-status")
      const formData = new FormData(form)

      if (button) {
        button.disabled = true
        button.textContent = "Envoi en cours..."
      }
      if (status) {
        status.classList.add("hidden")
        status.textContent = ""
      }

      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          body: formData
        })
        const result = await res.json()

        if (status) {
          status.classList.remove("hidden")
          if (result.ok) {
            status.className = "p-4 rounded-lg bg-accent/10 text-accent"
            status.textContent =
              "Votre message a bien été envoyé. Je vous réponds rapidement."
            form.reset()
          } else {
            status.className = "p-4 rounded-lg bg-red-50 text-red-600"
            status.textContent = result.error || "Une erreur est survenue."
          }
        }
      } catch (err) {
        if (status) {
          status.classList.remove("hidden")
          status.className = "p-4 rounded-lg bg-red-50 text-red-600"
          status.textContent = "Une erreur est survenue. Veuillez réessayer."
        }
      } finally {
        if (button) {
          button.disabled = false
          button.textContent = "Envoyer ma demande"
        }
      }
    })
  }
</script>
