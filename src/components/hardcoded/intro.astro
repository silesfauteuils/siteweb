---
import type { ContentAnimation } from './types'

interface Props {
  content: {
    heading: string
    subtitle: string
    animations?: ContentAnimation[]
  }
}

const { content } = Astro.props
---

<section
  id="contact-intro"
  class="relative py-24 md:py-32 overflow-hidden"
>
  <img
    src="/images/atelier.JPG"
    alt=""
    class="absolute inset-0 w-full h-full object-cover"
  />
  <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/60 to-black/40" />
  <div class="relative max-w-7xl mx-auto px-6">
    <h1
      class="font-heading text-4xl md:text-6xl text-white mb-6 max-w-3xl opacity-0"
      data-animate="fadeInUp"
      data-delay="0">
      {content.heading}
    </h1>
    <p
      class="text-white/80 text-lg md:text-xl max-w-2xl opacity-0"
      data-animate="fadeInUp"
      data-delay="0.1">
      {content.subtitle}
    </p>
  </div>
</section>
