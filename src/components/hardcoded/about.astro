---
import type { ContentImage, ContentAnimation } from './types'

interface Props {
  content: {
    badge: string
    name: string
    tagline: string
    categories: string[]
    specs: {
      icon: string
      label: string
      value: string
    }[]
    images: {
      main: ContentImage
    }
    buttons: {
      primary: { text: string; href: string }
    }
    animations?: ContentAnimation[]
  }
}

const { content } = Astro.props
---

<section id="about" class="py-16 md:py-24 bg-background">
  <div class="max-w-7xl mx-auto px-6" data-anim-wrapper>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <div data-anim="fadeInLeft">
        <p class="text-accent uppercase tracking-widest text-sm mb-4">{content.badge}</p>
        <h2 class="font-heading text-4xl md:text-5xl text-foreground mb-4">{content.name}</h2>
        <p class="text-muted text-lg mb-6">{content.tagline}</p>
        <div class="flex flex-wrap gap-3 mb-8">
          {content.categories.map(cat => (
            <span class="px-4 py-2 border border-foreground/10 text-foreground text-sm">{cat}</span>
          ))}
        </div>
        <div class="grid grid-cols-3 gap-4 mb-8">
          {content.specs.map(spec => (
            <div class="flex flex-col items-center text-center p-4 bg-background-warm">
              <img src={spec.icon} alt={spec.label} class="w-6 h-6 mb-2 invert opacity-60" />
              <p class="text-2xl font-heading text-foreground">{spec.value}</p>
              <p class="text-xs text-muted uppercase tracking-wider">{spec.label}</p>
            </div>
          ))}
        </div>
        <a
          href={content.buttons.primary.href}
          class="inline-flex items-center gap-2 px-8 py-4 bg-foreground text-white uppercase tracking-widest text-sm hover:bg-accent transition-colors"
        >
          {content.buttons.primary.text}
        </a>
      </div>
      <div data-anim="fadeInRight">
        <img
          src={content.images.main.src}
          alt={content.images.main.alt}
          class="w-full h-[500px] object-cover"
        />
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"

  gsap.registerPlugin(ScrollTrigger)

  const wrapper = document.querySelector('[data-anim-wrapper]')
  if (wrapper) {
    ScrollTrigger.create({
      trigger: wrapper,
      start: 'top 80%',
      once: true,
      onEnter: () => {
        gsap.to(wrapper.querySelectorAll('[data-anim="fadeInLeft"]'), {
          opacity: 1,
          x: 0,
          duration: 1,
          ease: 'power3.out'
        })
        gsap.to(wrapper.querySelectorAll('[data-anim="fadeInRight"]'), {
          opacity: 1,
          x: 0,
          duration: 1,
          ease: 'power3.out'
        })
      }
    })
  }
</script>
