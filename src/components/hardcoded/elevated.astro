---
import type { ContentImage, ContentAnimation } from './types'

interface Props {
  content: {
    images: ContentImage[]
    heading: string
    body: string
    animations?: ContentAnimation[]
  }
}

const { content } = Astro.props
---

<section id="elevated" class="py-24 bg-background">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class="font-heading text-5xl md:text-7xl text-foreground" data-animate="fadeInUp">
        {content.heading}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      {content.images.map((img, i) => (
        <div
          key={i}
          class="overflow-hidden"
          data-animate="fadeInUp"
          style={`transition-delay: ${(i + 1) * 0.15}s`}
        >
          <img
            src={img.src}
            alt={img.alt}
            class="w-full h-[400px] object-cover"
          />
        </div>
      ))}
    </div>

    <div class="max-w-2xl mx-auto text-center" data-animate="fadeInUp">
      <p class="text-muted text-lg leading-relaxed">{content.body}</p>
    </div>
  </div>
</section>
