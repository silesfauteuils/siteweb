---
import type { ContentImage, ContentAnimation } from './types'

interface ExploreCard {
  title: string
  image: ContentImage
  href: string
}

interface Props {
  content: {
    heading: string
    cards: ExploreCard[]
    neighborhood: {
      heading: string
      body: string
      button: { text: string; href: string }
      image: ContentImage
    }
    animations?: ContentAnimation[]
  }
}

const { content } = Astro.props
---

<section id="explore" class="py-24 bg-background">
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="font-heading text-4xl md:text-5xl text-foreground mb-12 text-center" data-animate="fadeInUp">
      {content.heading}
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      {content.cards.map((card, i) => (
        <a
          key={i}
          href={card.href}
          class="group block relative overflow-hidden"
          data-animate="fadeInUp"
          style={`transition-delay: ${(i + 1) * 0.15}s`}
        >
          <div className="relative h-[400px]">
            <img
              src={card.image.src}
              alt={card.image.alt}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
            <div class="absolute bottom-0 left-0 p-8">
              <p class="text-white font-heading text-2xl mb-2">{card.title}</p>
              <div class="flex items-center gap-2 text-white">
                <span class="uppercase tracking-widest text-sm">Explore</span>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M6 12L10 8L6 4" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center bg-background-warm p-8 md:p-12">
      <div>
        <h3 class="font-heading text-2xl md:text-3xl text-foreground mb-4" data-animate="fadeInUp">
          {content.neighborhood.heading}
        </h3>
        <p class="text-muted text-lg mb-6" data-animate="fadeInUp" style="transition-delay: 0.1s">
          {content.neighborhood.body}
        </p>
        <a
          href={content.neighborhood.button.href}
          class="inline-flex items-center gap-2 px-8 py-4 bg-foreground text-white uppercase tracking-widest text-sm hover:bg-accent transition-colors"
          data-animate="fadeInUp"
          style="transition-delay: 0.2s"
        >
          {content.neighborhood.button.text}
        </a>
      </div>
      <div data-animate="fadeInRight">
        <img
          src={content.neighborhood.image.src}
          alt={content.neighborhood.image.alt}
          class="w-full h-[300px] object-cover"
        />
      </div>
    </div>
  </div>
</section>
