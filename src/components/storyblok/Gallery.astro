---
import { storyblokEditable, renderRichText } from "@storyblok/astro"
import SbImage from "../SbImage.astro"

interface Props {
  blok: any
}

const { blok } = Astro.props
const textHtml = blok.text ? renderRichText(blok.text) : null
---

<section id="gallery" class="py-24 bg-background-warm" {...storyblokEditable(blok)}>
  <div class="max-w-7xl mx-auto px-6">
    <h2
      class="font-heading text-4xl md:text-5xl text-foreground mb-12 text-center opacity-0"
      data-animate="fadeInUp">
      {blok.heading}
    </h2>
    {
      blok.text && (
        <div
          class="max-w-3xl mx-auto text-justify mb-12 opacity-0"
          data-animate="fadeInUp">
          <p
            class="text-foreground text-lg leading-relaxed"
            set:html={textHtml}
          />
        </div>
      )
    }
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
      {
        blok.items?.map((item: any, i: number) => (
          <div
            key={i}
            class="group overflow-hidden opacity-0 gallery-card"
            data-animate="fadeInUp"
            data-delay={(i + 1) * 0.15}>
            {item.image?.filename && (
              <SbImage
                src={item.image}
                widths={[300, 720, 1080]}
                sizes="(max-width: 768px) 100vw, 25vw"
                class="w-full h-[450px] object-cover"
              />
            )}
            <p class="mt-4 font-heading text-xl text-foreground">
              {item.caption}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap"

  document.querySelectorAll(".gallery-card").forEach((card) => {
    const img = card.querySelector("img")
    if (!img) return

    card.addEventListener("mouseenter", () => {
      gsap.to(img, { scale: 1.05, duration: 0.6, ease: "power2.out" })
    })

    card.addEventListener("mouseleave", () => {
      gsap.to(img, { scale: 1, duration: 0.6, ease: "power2.out" })
    })
  })
</script>
