---
import { storyblokEditable, renderRichText } from "@storyblok/astro"

interface Props {
  blok: any
}

const { blok } = Astro.props
const neighborhoodBodyHtml = renderRichText(blok.neighborhood?.body)
---

<section id="explore" class="py-24 bg-background" {...storyblokEditable(blok)}>
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="font-heading text-4xl md:text-5xl text-foreground mb-12 text-center opacity-0" data-animate="fadeInUp">
      {blok.heading}
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      {blok.cards?.map((card: any, i: number) => (
        <a
          key={i}
          href={card.href || "#"}
          class="group block relative overflow-hidden opacity-0 explore-card"
          data-animate="fadeInUp"
          data-delay={(i + 1) * 0.15}>
          <div class="relative h-[400px]">
            {card.image?.filename && (
              <img
                src={card.image.filename}
                alt={card.image.alt || ""}
                class="w-full h-full object-cover"
              />
            )}
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent" />
            <div class="absolute bottom-0 left-0 p-8">
              <p class="text-white font-heading text-2xl mb-2">{card.title}</p>
              <div class="flex items-center gap-2 text-white">
                <span class="uppercase tracking-widest text-sm">Explore</span>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M6 12L10 8L6 4" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    {blok.neighborhood && (
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center bg-background-warm p-8 md:p-12">
        <div>
          <h3 class="font-heading text-2xl md:text-3xl text-foreground mb-4 opacity-0" data-animate="fadeInUp">
            {blok.neighborhood.heading}
          </h3>
          <p class="text-muted text-lg mb-6 opacity-0" data-animate="fadeInUp" data-delay="0.1" set:html={neighborhoodBodyHtml}>
          </p>
          <a
            href={blok.neighborhood.button_link || "#"}
            class="inline-flex items-center gap-2 px-8 py-4 bg-foreground text-white uppercase tracking-widest text-sm hover:bg-accent transition-colors opacity-0"
            data-animate="fadeInUp"
            data-delay="0.2">
            {blok.neighborhood.button_text}
          </a>
        </div>
        <div data-animate="fadeInRight" data-delay="0.2" class="opacity-0">
          {blok.neighborhood.image?.filename && (
            <img
              src={blok.neighborhood.image.filename}
              alt={blok.neighborhood.image.alt || ""}
              class="w-full h-[300px] object-cover"
            />
          )}
        </div>
      </div>
    )}
  </div>
</section>

<script>
  import { gsap } from "gsap"

  document.querySelectorAll(".explore-card").forEach((card) => {
    const img = card.querySelector("img")
    if (!img) return

    card.addEventListener("mouseenter", () => {
      gsap.to(img, { scale: 1.05, duration: 0.6, ease: "power2.out" })
    })

    card.addEventListener("mouseleave", () => {
      gsap.to(img, { scale: 1, duration: 0.6, ease: "power2.out" })
    })
  })
</script>
