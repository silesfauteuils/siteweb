---
import { storyblokEditable } from "@storyblok/astro"
import SbImage from "../SbImage.astro"

interface Props {
  blok: any
}

const { blok } = Astro.props
const description = typeof blok.description === "string" ? blok.description : ""
---

<footer id="siteFooter" class="bg-foreground text-white py-16" {...storyblokEditable(blok)}>
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 mb-12">
      <div>
        <p class="text-accent uppercase tracking-widest text-sm mb-6 opacity-0" data-animate="fadeInUp">
          {blok.tagline}
        </p>
        {blok.logo?.filename && (
          <SbImage
            src={blok.logo}
            widths={[160, 320]}
            sizes="200px"
            class="h-12 w-auto mb-6 opacity-0"
            data-animate="fadeInUp"
            data-delay="0.1"
          />
        )}
        <p class="text-white/70 max-w-sm opacity-0" data-animate="fadeInUp" data-delay="0.2">
          {description}
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        {blok.menus?.map((menu: any, i: number) => (
          <div key={i} class="opacity-0" data-animate="fadeInUp" data-delay={(i + 1) * 0.1}>
            <p class="text-white uppercase tracking-widest text-sm mb-4">{menu.title}</p>
            <ul class="space-y-2">
              {menu.links?.map((link: any) => (
                <li>
                  <a href={link.href || "#"} class="text-white/70 hover:text-white transition-colors text-sm">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-white/50 text-sm">{blok.copyright}</p>
      <div class="flex gap-6">
        {blok.legal_links?.map((link: any) => (
          <a key={link.href} href={link.href || "#"} class="text-white/50 hover:text-white text-sm transition-colors">
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
