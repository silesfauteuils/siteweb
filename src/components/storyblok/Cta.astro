---
import { storyblokEditable, renderRichText } from "@storyblok/astro"

interface Props {
  blok: any
}

const { blok } = Astro.props
const textHtml = renderRichText(blok.text)

// Button renders only when both text and link are provided in the CMS
const buttonHref =
  blok.button_link?.url ||
  (blok.button_link?.cached_url ? `/${blok.button_link.cached_url}` : null)
---

<section id="cta" class="py-24 bg-foreground" {...storyblokEditable(blok)}>
  <div class="max-w-3xl mx-auto px-6 text-center">
    <h2
      class="font-heading text-3xl md:text-5xl text-white mb-8 leading-tight opacity-0"
      data-animate="fadeInUp">
      {blok.headline}
    </h2>
    <div
      class="text-white/80 text-justify text-lg leading-relaxed mb-10 opacity-0"
      data-animate="fadeInUp"
      data-delay="0.1">
      <Fragment set:html={textHtml} />
    </div>
    {blok.button_text && buttonHref && (
      <a
        href={buttonHref}
        class="inline-flex items-center gap-2 px-8 py-4 bg-accent text-white uppercase tracking-widest text-sm hover:bg-white hover:text-foreground transition-colors opacity-0"
        data-animate="fadeInUp"
        data-delay="0.2">
        {blok.button_text}
      </a>
    )}
  </div>
</section>
