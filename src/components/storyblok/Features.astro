---
import { storyblokEditable, renderRichText } from "@storyblok/astro"
import SbImage from "../SbImage.astro"

interface Props {
  blok: any
}

const { blok } = Astro.props
const bodyHtml = renderRichText(blok.body)
---

<section class="bg-background py-24" {...storyblokEditable(blok)}>
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div>
        <div
          class="rounded-2xl overflow-hidden opacity-0"
          data-animate="fadeInRight">
          {blok.image?.filename && (
            <SbImage
              src={blok.image}
              widths={[480, 800, 1200]}
              sizes="(max-width: 1024px) 100vw, 50vw"
              class="w-full h-[600px] object-cover"
            />
          )}
        </div>
      </div>
      <div>
        {blok.subtitle && (
          <span
            class="text-accent uppercase tracking-widest text-sm mb-4 block opacity-0"
            data-animate="fadeInLeft">
            {blok.subtitle}
          </span>
        )}
        <h2
          class="font-heading text-4xl md:text-5xl text-foreground leading-tight mb-6 opacity-0"
          data-animate="fadeInLeft">
          {blok.heading}
        </h2>
        <div
          class="font-body text-justify text-muted text-lg leading-relaxed opacity-0"
          data-animate="fadeInLeft">
          <Fragment set:html={bodyHtml} />
        </div>
        {blok.button_text && (
          <div class="mt-8 opacity-0" data-animate="fadeInLeft">
            <a
              href={blok.button_href?.url || (blok.button_href?.cached_url ? `/${blok.button_href.cached_url}` : "#")}
              class="inline-flex items-center gap-2 px-8 py-4 bg-foreground text-white uppercase tracking-widest text-sm hover:bg-accent transition-colors">
              {blok.button_text}
            </a>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
