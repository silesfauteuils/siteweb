---
import { storyblokEditable, renderRichText } from "@storyblok/astro"
import SbImage from "../SbImage.astro"

interface Props {
  blok: any
}

const { blok } = Astro.props
const bodyHtml = renderRichText(blok.body)
---

<section id="elevated" class="py-24 bg-background" {...storyblokEditable(blok)}>
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-12">
      <h2 class="font-heading text-5xl md:text-7xl text-foreground opacity-0" data-animate="fadeInUp">
        {blok.heading}
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      {blok.images?.map((img: any, i: number) => (
        <div
          key={i}
          class="overflow-hidden opacity-0"
          data-animate="fadeInUp"
          data-delay={(i + 1) * 0.15}>
          {img.filename && (
            <SbImage
              src={img}
              widths={[480, 800, 1200]}
              sizes="(max-width: 768px) 100vw, 50vw"
              class="w-full h-[400px] object-cover"
            />
          )}
        </div>
      ))}
    </div>

    {blok.body && (
      <div class="max-w-2xl mx-auto text-center opacity-0" data-animate="fadeInUp">
        <p class="text-muted text-lg leading-relaxed" set:html={bodyHtml}></p>
      </div>
    )}
  </div>
</section>
