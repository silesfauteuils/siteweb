---
import { storyblokEditable, renderRichText } from "@storyblok/astro"
import SbImage from "../SbImage.astro"

interface Props {
  blok: any
}

const { blok } = Astro.props
const bodyHtml = renderRichText(blok.body)
---

<section class="bg-background py-24" {...storyblokEditable(blok)}>
  <div class="max-w-7xl mx-auto px-6">
    <div class="max-w-3xl mb-16 opacity-0" data-animate="fadeInUp">
      <h2 class="font-heading text-4xl md:text-5xl text-foreground leading-tight">
        {blok.heading}
      </h2>
      {blok.body && (
        <p class="font-body text-muted text-lg mt-6 leading-relaxed" set:html={bodyHtml}>
        </p>
      )}
    </div>

    {blok.main_image?.filename && (
      <div class="mb-12 rounded-xl overflow-hidden opacity-0" data-animate="fadeInUp">
        <SbImage
          src={blok.main_image}
          widths={[640, 1280, 1920]}
          sizes="100vw"
          class="w-full h-[500px] object-cover"
        />
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {blok.grid_images?.map((image: any, index: number) => (
        <div
          class="rounded-xl overflow-hidden aspect-video opacity-0"
          data-animate="fadeInUp"
          data-delay={index * 0.1}>
          {image.filename && (
            <SbImage
              src={image}
              widths={[400, 800]}
              sizes="(max-width: 768px) 100vw, 33vw"
              class="w-full h-full object-cover"
            />
          )}
        </div>
      ))}
    </div>
  </div>
</section>
