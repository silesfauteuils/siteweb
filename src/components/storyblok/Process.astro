---
import { storyblokEditable, renderRichText } from "@storyblok/astro"

interface Props {
  blok: any
}

const { blok } = Astro.props
const outroHtml = renderRichText(blok.outro)
const stepsWithHtml = blok.steps?.map((step: any) => ({
  ...step,
  textHtml: renderRichText(step.text)
}))

// Button renders only when both text and link are provided in the CMS
const buttonHref =
  blok.button_link?.url ||
  (blok.button_link?.cached_url ? `/${blok.button_link.cached_url}` : null)
---

<section id="process" class="py-24 bg-background" {...storyblokEditable(blok)}>
  <div class="max-w-4xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2
        class="font-heading text-3xl md:text-4xl text-foreground leading-tight opacity-0"
        data-animate="fadeInUp">
        {blok.title}
      </h2>
    </div>

    <ol class="space-y-8 mb-20">
      {
        stepsWithHtml?.map((step: any, i: number) => (
          <li
            key={i}
            class="flex gap-6 items-start opacity-0"
            data-animate="fadeInUp"
            data-delay={i * 0.1}>
            <span class="flex items-center justify-center w-10 h-10 shrink-0 rounded-full bg-foreground text-white font-heading text-lg">
              {i + 1}
            </span>
            <div class="pt-1.5">
              <p
                class="text-foreground text-lg leading-relaxed"
                set:html={step.text}
              />
            </div>
          </li>
        ))
      }
    </ol>

    <div class="text-justify my-12 opacity-0" data-animate="fadeInUp">
      <p class="text-muted text-xs uppercase tracking-widest mb-4">
        Délais & Livraison
      </p>
      <div
        class="text-foreground text-lg leading-relaxed max-w-3xl"
        set:html={outroHtml}
      />
    </div>

    {blok.button_text && buttonHref && (
      <div class="text-center">
        <a
          href={buttonHref}
          class="inline-flex items-center gap-2 px-8 py-4 bg-foreground text-white uppercase tracking-widest text-sm hover:bg-accent transition-colors opacity-0"
          data-animate="fadeInUp"
          data-delay="0.3">
          {blok.button_text}
        </a>
      </div>
    )}
  </div>
</section>
