        ],
        heading: "Elevated",
        body: "Rising 35 stories above the city, Lumea Residence defines the art of elevated living. With only 120 carefully curated residences each apartment is designed."
      }}
    />

    <Amenities
      content={{
        badge: "extraordinary experiences",
        heading:
          "Exclusive Amenities Designed for a Lifestyle Beyond your apartment walls",
        body: "Living at Lumea Residence extends far beyond your apartment walls. Residents enjoy access to a rooftop sky garden, wellness and fitness center, private lounges, and a full-service concierge. These amenities are tailored to elevate everyday routines into extraordinary experiences, providing a lifestyle that blends leisure, privacy, and prestige.",
        images: {
          main: {
            src: "/images/lumea/amenities.webp",
            alt: "Rooftop infinity pool with city panoramic views"
          }
        }
      }}
    />

    <Testimonial
      content={{
        rating: "stars",
        quote:
          '"Living at Lumea has redefined city life for me – the views are priceless, and the service is world-class."',
