---
import { useStoryblokApi } from "@storyblok/astro"
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro"
import Layout from "../layouts/Layout.astro"
import Footer from "../components/Footer.astro"

const storyblokApi = useStoryblokApi()
const { slug } = Astro.params

// For SSG: Generate static paths for all stories
export async function getStaticPaths() {
  const sbApi = useStoryblokApi()

  // Use 'draft' version in preview mode, 'published' otherwise
  const version = import.meta.env.IS_PREVIEW ? "draft" : "published"

  const { data } = await sbApi.get("cdn/stories", {
    version,
    per_page: 100
  })

  // Remove global story (for configuration purposes only)
  const filteredStories = data.stories.filter(
    (story) => story.full_slug !== "global"
  )

  return filteredStories.map((story) => ({
    params: {
      slug:
        story.full_slug === "home" || story.full_slug === ""
          ? undefined
          : story.full_slug
    },
    props: { story }
  }))
}

let story

if (import.meta.env.IS_PREVIEW) {
  // SSR mode: fetch on-demand for Storyblok visual editor
  const storySlug = slug || "home"
  try {
    const { data } = await storyblokApi.get(`cdn/stories/${storySlug}`, {
      version: "draft",
      resolve_links: "url"
    })
    story = data.story
  } catch (error) {
    console.error("[DEBUG] Storyblok API error:", error.message)
  }
} else {
  // SSG mode: story comes from getStaticPaths props
  story = Astro.props.story
}

// Guard: If story is undefined, return 404
if (!story) {
  return new Response(null, {
    status: 404,
    statusText: "Not found"
  })
}

const seo = {
  title: story.content?.title || "Page non trouvée",
  description: story.content?.description || "Page non trouvée",
  robots: story.content?.robots || "all",
  schema: story.content?.schema || null,
  ogImage: story.content?.ogImage?.filename || null,
  ogImageAlt: story.content?.ogImageAlt || story.content?.ogImage?.alt || " ",
  canonical: story.content?.canonical?.url || null
}
---

<Layout seo={seo}>
  <StoryblokComponent blok={story.content} />
  <Footer />
</Layout>
