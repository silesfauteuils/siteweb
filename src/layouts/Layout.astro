---
import Head from "./Head.astro"
import SkipLink from "./SkipLink.astro"
import TopBanner from "../components/TopBanner.astro"
import Analytics from "@vercel/analytics/astro"

import "../styles/global.css"
import "lenis/dist/lenis.css"

interface Props {
  seo?: object
}

const { seo } = Astro.props
---

<!doctype html>
<html lang="fr">
  <head>
    <Head seo={seo} />
    <Analytics />
  </head>
  <body class="antialiased">
    <SkipLink />
    <TopBanner />

    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

<script>
  import Lenis from "lenis"
  import { gsap } from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"

  gsap.registerPlugin(ScrollTrigger)

  // Initialize Lenis
  const lenis = new Lenis({
    duration: 1.2,
    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    orientation: "vertical",
    gestureOrientation: "vertical",
    smoothWheel: true,
    wheelMultiplier: 1
  })

  // Expose Lenis globally for other components
  ;(window as any).lenis = lenis

  // Sync Lenis with ScrollTrigger
  lenis.on("scroll", ScrollTrigger.update)
  gsap.ticker.add((time) => {
    lenis.raf(time * 1000)
  })
  gsap.ticker.lagSmoothing(0)

  ScrollTrigger.config({
    ignoreMobileResize: true
  })

  function getAnimationState(type: string): Record<string, number> {
    switch (type) {
      case "fadeInUp":
        return { y: 40 }
      case "fadeInDown":
        return { y: -40 }
      case "fadeInLeft":
        return { x: -40 }
      case "fadeInRight":
        return { x: 40 }
      case "scaleIn":
        return { scale: 0.9 }
      case "scaleOut":
        return { scale: 1.1 }
      case "parallax":
        return { yPercent: -20 }
      default:
        return {}
    }
  }

  function createToState(el: Element, fromState: Record<string, any>): any {
    const duration = parseFloat(el.dataset.duration || "0.8")
    const delay = parseFloat(el.dataset.delay || "0")
    const ease = el.dataset.ease || "power3.out"

    const toState: any = {
      opacity: 1,
      x: 0,
      y: 0,
      scale: 1,
      yPercent: 0,
      duration,
      delay,
      ease
    }

    if (fromState.yPercent) toState.yPercent = 0
    if (fromState.scale) toState.scale = 1

    return toState
  }

  // Separate above-fold (animate immediately) and below-fold (ScrollTrigger)
  const allAnimated = Array.from(document.querySelectorAll("[data-animate]"))
  const aboveFold: Element[] = []
  const belowFold: Element[] = []

  allAnimated.forEach((el) => {
    const rect = el.getBoundingClientRect()
    if (rect.top < window.innerHeight * 0.95) {
      aboveFold.push(el)
    } else {
      belowFold.push(el)
    }
  })

  // Animate above-fold elements immediately
  aboveFold.forEach((el) => {
    const type = el.getAttribute("data-animate") || "fadeInUp"
    const duration = parseFloat(el.dataset.duration || "0.8")
    const delay = parseFloat(el.dataset.delay || "0")
    const ease = el.dataset.ease || "power3.out"

    const fromVars = { opacity: 0, ...getAnimationState(type) }
    const toVars = createToState(el, fromVars)

    gsap.set(el, fromVars)
    gsap.to(el, toVars)
  })

  // ScrollTrigger for below-fold elements
  belowFold.forEach((el) => {
    const type = el.getAttribute("data-animate") || "fadeInUp"
    const duration = parseFloat(el.dataset.duration || "0.8")
    const delay = parseFloat(el.dataset.delay || "0")
    const ease = el.dataset.ease || "power3.out"

    const fromVars = { opacity: 0, ...getAnimationState(type) }
    const toVars = createToState(el, fromVars)

    gsap.set(el, fromVars)

    ScrollTrigger.create({
      trigger: el,
      start: "top 85%",
      once: true,
      onEnter: () => gsap.to(el, toVars)
    })
  })

  // Refresh after all setup
  ScrollTrigger.refresh()
</script>
