---
import Head from "./Head.astro"
import SkipLink from "./SkipLink.astro"
import Analytics from "@vercel/analytics/astro"

import "../styles/global.css"
import "lenis/dist/lenis.css"

interface Props {
  seo?: object
}

const { seo } = Astro.props
---

<!doctype html>
<html lang="fr">
  <head>
    <Head seo={seo} />
    <Analytics />
  </head>
  <body class="antialiased">
    <SkipLink />

    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

<script>
  import Lenis from "lenis"
  import { gsap } from "gsap"
  import { ScrollTrigger } from "gsap/ScrollTrigger"

  // Initialize Lenis
  const lenis = new Lenis({
    duration: 1.2,
    easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
    orientation: "vertical",
    gestureOrientation: "vertical",
    smoothWheel: true,
    wheelMultiplier: 1
  })

  // Expose Lenis globally for other components
  ;(window as any).lenis = lenis

  // Sync Lenis with ScrollTrigger
  lenis.on("scroll", ScrollTrigger.update)
  gsap.ticker.add((time) => {
    lenis.raf(time * 1000)
  })
  gsap.ticker.lagSmoothing(0)

  // Global animation configurations
  ScrollTrigger.config({
    ignoreMobileResize: true
  })

  // Initialize data-animate animations
  const animatedElements = document.querySelectorAll('[data-animate]')
  animatedElements.forEach((el) => {
    const type = el.getAttribute('data-animate') || 'fadeInUp'
    const delay = parseFloat((el as HTMLElement).dataset.delay || '0')
    const duration = parseFloat((el as HTMLElement).dataset.duration || '0.8')

    let fromVars: any = { opacity: 0, duration, delay, ease: 'power3.out' }

    switch (type) {
      case 'fadeInUp':
        fromVars.y = 40
        break
      case 'fadeInDown':
        fromVars.y = -40
        break
      case 'fadeInLeft':
        fromVars.x = -40
        break
      case 'fadeInRight':
        fromVars.x = 40
        break
      case 'scaleIn':
        fromVars.scale = 0.9
        break
      case 'parallax':
        fromVars.yPercent = -20
        break
    }

    ScrollTrigger.create({
      trigger: el as Element,
      start: 'top 85%',
      once: true,
      onEnter: () => {
        gsap.fromTo(el as Element, fromVars, { opacity: 1, x: 0, y: 0, scale: 1, yPercent: 0 })
      }
    })
  })
</script>
